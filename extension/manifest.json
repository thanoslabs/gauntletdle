{
  "manifest_version": 3,
  "name": "Gauntletdle Companion",
  "version": "0.1.0",
  "description": "Optional companion for Gauntletdle daily games",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.nytimes.com/games/wordle/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/games/wordle/*"
      ],
      "js": [
        "wordle.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://thanoslabs.github.io/gauntletdle/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
